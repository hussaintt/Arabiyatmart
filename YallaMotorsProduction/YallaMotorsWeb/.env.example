# ==============================================================================
# Arabiyatmart Web Application Environment Configuration
# Copy this file to .env.local for local development.
# Do NOT commit .env, .env.local, or any production secrets to version control.
# In production, all origins must use HTTPS and secrets must decode to at least 32 characters.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment and Runtime Flags
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
PORT=3001
HOST=0.0.0.0
MAINTENANCE_MODE=false
CSP_REPORT_ONLY=false

# ------------------------------------------------------------------------------
# 2. Origins (Server-side)
# In production, SITE_ORIGIN and BACKEND_API_ORIGIN must use HTTPS.
# ------------------------------------------------------------------------------
SITE_ORIGIN=http://localhost:3001
BACKEND_API_ORIGIN=http://localhost:3000
MEDIA_CDN_ORIGIN=

# ------------------------------------------------------------------------------
# 3. Authentication, JWT, and CSRF Security (Server-only)
# Secrets must be at least 32 characters long and must not contain placeholder words.
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=arabiyatmart-backend
JWT_AUDIENCE=arabiyatmart-mobile
CSRF_SECRET=
INTERNAL_API_SECRET=

# ------------------------------------------------------------------------------
# 4. Idempotency Storage
# Supported drivers: memory | redis. When redis is selected, REDIS_URL is required.
# ------------------------------------------------------------------------------
IDEMPOTENCY_STORAGE_DRIVER=memory
REDIS_URL=
IDEMPOTENCY_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 5. OAuth Server Settings
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ------------------------------------------------------------------------------
# 6. Firebase Server Service Credentials
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 7. Observability and Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=yalla-motors-web
LOG_LEVEL=info
RELEASE=

# ------------------------------------------------------------------------------
# 8. Documented Public Client Configuration (NEXT_PUBLIC_*)
# Only variables prefixed with NEXT_PUBLIC_ are bundled into client-side code.
# Backend secrets, tokens, and storage keys must NEVER be exposed here.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_MEDIA_CDN_ORIGIN=
NEXT_PUBLIC_APP_ENV=development

# Google OAuth Web Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Modular Web SDK Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Browser analytics is disabled until both values are configured and the user grants consent.
# Keep the endpoint same-origin; never place analytics secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
