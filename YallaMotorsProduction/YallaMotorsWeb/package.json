{
  "name": "yalla-motors-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "build:e2e": "NODE_ENV=production APP_ENV=test SITE_ORIGIN=http://127.0.0.1:3100 NEXT_PUBLIC_SITE_ORIGIN=https://e2e.arabiyatmart.test BACKEND_API_ORIGIN=http://127.0.0.1:3200 NEXT_PUBLIC_API_BASE_URL=https://api.e2e.arabiyatmart.test MEDIA_CDN_ORIGIN=https://cdn.e2e.arabiyatmart.test NEXT_PUBLIC_MEDIA_CDN_ORIGIN=https://cdn.e2e.arabiyatmart.test NEXT_PUBLIC_APP_ENV=test npm run build",
    "start": "next start --port 3001",
    "type-check": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "check:boundaries": "node scripts/check-client-boundaries.mjs",
    "check:routes": "node scripts/check-route-inventory.mjs",
    "check:bundles": "node scripts/check-bundle-budgets.mjs",
    "check:test-policy": "node scripts/check-test-policy.mjs",
    "check:content": "node scripts/check-release-content.mjs",
    "check:traceability": "node scripts/check-traceability.mjs",
    "check:release": "npm run check:test-policy && npm run check:content && npm run check:routes && npm run check:traceability && npm run check:boundaries && npm run type-check && npm run lint",
    "test:lighthouse": "lhci autorun",
    "test:unit": "vitest run --project=unit",
    "test:unit:coverage": "vitest run --project=unit --coverage",
    "test:component": "vitest run --project=component",
    "test:component:coverage": "vitest run --project=component --coverage",
    "test:contract": "vitest run --project=contract",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:component && npm run test:contract && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "firebase": "^12.18.0",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "^15.5.25",
    "next-intl": "^4.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "1.0.7",
    "vaul": "1.1.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.5",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
